# =========================================================
# Myntra Growth Intelligence & VoC Discovery Engine Config
# =========================================================

# LLM Provider: 'gemini' (Recommended) or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get a free key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Active Model Name:
# - For Gemini: 'gemini-3.6-flash' (Fast & Recommended) or 'gemini-3.7-flash'
# - For OpenAI: 'gpt-4o-mini' or 'gpt-4o'
LLM_MODEL_NAME=gemini-3.6-flash

# Generation Temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.2
